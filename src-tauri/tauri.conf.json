{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batlay",
  "mainBinaryName": "Batlay",
  "version": "0.5.0",
  "identifier": "com.adil.batlay",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:front",
    "beforeBuildCommand": "npm run build:front"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Adil",
    "copyright": "Copyright (c) Adil",
    "category": "Video",
    "shortDescription": "Overlays musique, chat et alertes pour le streaming",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../dist": "dist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "../assets/installer/installerSidebar.bmp",
        "headerImage": "../assets/installer/installerHeader.bmp",
        "uninstallerHeaderImage": "../assets/installer/installerHeader.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
