{
  "name": "batlay",
  "productName": "Batlay",
  "version": "0.5.0",
  "description": "Batlay - Application desktop d'overlays pour le streaming (OBS) : musique en cours, chat Twitch et TikTok, alertes",
  "author": "Adil",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BatStream-off/Batlay.git"
  },
  "scripts": {
    "dev": "npm run tauri -- dev",
    "dev:front": "vite build && vite",
    "build:front": "tsc -b && vite build",
    "tauri": "npx --yes @tauri-apps/cli@2",
    "dist": "npm run tauri -- build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "cargo test --manifest-path crates/batlay-core/Cargo.toml",
    "lint": "eslint . --ext ts,tsx"
  },
  "dependencies": {
    "zustand": "^4.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "nanoid": "^5.0.7",
    "lucide-react": "^0.383.0",
    "@fontsource-variable/inter": "^5.0.18",
    "@fontsource-variable/space-grotesk": "^5.0.18",
    "@fontsource-variable/sora": "^5.0.18",
    "@fontsource-variable/jetbrains-mono": "^5.0.20"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
